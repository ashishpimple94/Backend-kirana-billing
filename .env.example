PORT=5000
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
# LLM_PROVIDER: gemini (default, cloud) | qwen (local Ollama) | openai
LLM_PROVIDER=gemini
# Only used when LLM_PROVIDER=qwen (Qwen via Ollama). Render can't reach an Ollama on
# your local PC — run the backend locally (or host Ollama), then set these:
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b
OLLAMA_API_KEY=
PRICE_MODE=per_unit
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.ezzkjmw.mongodb.net/kirana_billing?retryWrites=true&w=majority
# Redis Cache (optional - e.g. rediss://default:pwd@host:port or redis://127.0.0.1:6379)
# If omitted, system runs smoothly with direct MongoDB.
REDIS_URL=
